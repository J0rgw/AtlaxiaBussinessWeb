# Public site config (read at build / runtime)
# Defaults to https://atlaxia.example and helloatlaxia@gmail.com if unset.

NEXT_PUBLIC_SITE_URL=https://atlaxia.example
NEXT_PUBLIC_CONTACT_EMAIL=helloatlaxia@gmail.com

# GitHub Pages subpath. Leave empty for root / custom-domain hosting.
# For project pages at https://<user>.github.io/<repo>/ set this to "/<repo>".
# NEXT_PUBLIC_BASE_PATH=/atlaxia-web

# Formspree form id. Get one at https://formspree.io (free tier).
# Without this the form will show an error message instead of submitting.
# NEXT_PUBLIC_FORMSPREE_ID=xyzabc12
